#' checksum is the identity of the file.
#'
#' Login: in an interactive session a browser window opens
#' (`genesysr::user_login()`). Otherwise set `GENESYS_CLIENT_ID` and
#' `GENESYS_CLIENT_SECRET` for an API client registered with Genesys.
#'
#' @param project Project list from `read_project()`;
#'   `project$sources$genesys$query` holds `genus` and optional `species`
#'   (epithets).
#' @return The manifest row for the downloaded file.
fetch_genesys <- function(project) {
q <- project$sources$genesys$query
client <- Sys.getenv(c("GENESYS_CLIENT_ID", "GENESYS_CLIENT_SECRET"))
if (all(nzchar(client))) {
genesysr::setup(server = "https://api.genesys-pgr.org",
client_id = client[[1]], client_secret = client[[2]])
genesysr::client_login()
} else if (interactive()) {
genesysr::setup_production()
genesysr::user_login()
} else {
stop("Genesys needs a login: run interactively, or set GENESYS_CLIENT_ID ",
"and GENESYS_CLIENT_SECRET.", call. = FALSE)
}
filters <- genesysr::mcpd_filter(GENUS = q$genus, SPECIES = unlist(q$species))
accessions <- genesysr::get_accessions(filters, fields = genesysr::SELECT_ALL_FIELDS)
date <- format(Sys.Date(), "%Y%m%d")
dir <- file.path("inputs", "occurrence", "genesys")
dir.create(file.path(data_root(), dir), recursive = TRUE, showWarnings = FALSE)
file <- file.path(dir, paste0(project$name, "_", date, ".csv"))
readr::write_csv(accessions, file.path(data_root(), file), na = "")
manifest_add(
file = file,
input_id = paste0("genesys_", project$name, "_", date),
kind = "occurrence",
source = "genesys",
version = date,
retrieved_by = "fetch_genesys",
query = jsonlite::toJSON(q, auto_unbox = TRUE),
notes = paste(nrow(accessions), "accessions")
)
}
